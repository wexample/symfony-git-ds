{
  "name": "wexample/symfony-git-ds",
  "description": "A git repository's history drawn as a graph, read page after page as it is scrolled",
  "version": "2.0.2",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyGitDs\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=38.0.0",
    "wexample/symfony-git": ">=2.0.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.3.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}