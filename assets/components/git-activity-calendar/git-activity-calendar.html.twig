{#- A year of commits as a contribution calendar: a square a day, a column a
    week from Monday, its shade one of five levels. Drawn here as svg, so
    that it runs no script; each day tells its count to the pointer and to
    the screen reader. -#}
<figure class="git-activity-calendar{% if class|default(null) %} {{ class }}{% endif %}">
    <svg class="git-activity-calendar--svg"
         viewBox="0 0 {{ layout.width }} {{ layout.height }}"
         role="img"
         aria-label="{{ '@component::label' | trans({ '%count%': commits }) }}">
        {%- for month in layout.months -%}
            <text class="git-activity-calendar--label" x="{{ month.x }}" y="11">{{ month.label }}</text>
        {%- endfor -%}
        {%- for weekday in layout.weekdays -%}
            <text class="git-activity-calendar--label" x="0" y="{{ weekday.y }}">{{ weekday.label }}</text>
        {%- endfor -%}
        {%- for cell in layout.cells -%}
            <rect class="git-activity-calendar--cell git-activity-calendar--level-{{ cell.level }}" x="{{ cell.x }}" y="{{ cell.y }}" width="{{ cell_size }}" height="{{ cell_size }}" rx="2">
                <title>{{ '@component::day' | trans({ '%count%': cell.commits, '%date%': cell.date }) }}</title>
            </rect>
        {%- endfor -%}
        <text class="git-activity-calendar--label" x="{{ layout.legend_less_x }}" y="{{ layout.legend_y + cell_size - 1 }}" text-anchor="end">{{ '@component::less' | trans }}</text>
        {%- for step in layout.legend -%}
            <rect class="git-activity-calendar--cell git-activity-calendar--level-{{ step.level }}" x="{{ step.x }}" y="{{ layout.legend_y }}" width="{{ cell_size }}" height="{{ cell_size }}" rx="2"></rect>
        {%- endfor -%}
        <text class="git-activity-calendar--label" x="{{ layout.legend_more_x }}" y="{{ layout.legend_y + cell_size - 1 }}">{{ '@component::more' | trans }}</text>
    </svg>
</figure>
